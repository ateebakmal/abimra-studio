<section class="sec proof" style="padding-top:0"><div class="wrap proof-grid">
  <div class="proof-copy">
    <h2 class="d2">No guesswork. Every order gets a <em>job ticket.</em></h2>
    <p>We run the studio like a proper print shop. Here’s what every order goes through, from your upload to your door.</p>
    <ul class="proof-facts">
      <li><b>In-house</b><span>Printed in our own UK studio</span></li>
      <li><b>2–4 days</b><span>From order to dispatch</span></li>
      <li><b>No min.</b><span>One shirt or fifty</span></li>
    </ul>
    <a class="btn btn-p" href="#">Start your ticket</a>
  </div>
  <div class="rig" aria-label="An example job ticket">
    <div class="printer" aria-hidden="true"><span class="led">STUDIO PRINTER</span><span>JOB 00412</span></div>
    <div class="ticket-clip">
      <article class="ticket">
        <div class="tk-head">
          <div><div class="tk-brand"><svg  viewBox="-20 -20 40 40" aria-hidden="true"><circle r="10" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M-18 0H18M0-18V18" stroke="currentColor" stroke-width="2.6"/><circle r="3.8" fill="#D42E12"/></svg><span>Abimra Studio</span></div><p class="tk-title">Job ticket</p></div>
          <div class="tk-meta"><b>No. 00412</b><span data-today>25 Sep 2026</span><br>Customer copy</div>
        </div>
        <ol class="tk-rows">
          <li><small>Artwork</small><span>Resolution checked live as you scale it</span><i class="tk-box"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.4 12 13 4.5"/></svg></i></li>
          <li><small>Background</small><span>Removed for you</span><i class="tk-box"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.4 12 13 4.5"/></svg></i></li>
          <li><small>Placement</small><span>Front, back, chest or sleeve</span><i class="tk-box"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.4 12 13 4.5"/></svg></i></li>
          <li><small>Preview</small><span>On the exact garment and colour you picked</span><i class="tk-box"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.4 12 13 4.5"/></svg></i></li>
          <li><small>Print</small><span>DTF on washed cotton, in our own studio</span><i class="tk-box"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.4 12 13 4.5"/></svg></i></li>
          <li><small>Dispatch</small><span>2–4 days, delivered across the UK</span><i class="tk-box"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.4 12 13 4.5"/></svg></i></li>
        </ol>
        <div class="tk-foot"><svg class="tk-code" viewBox="0 0 150 34" aria-hidden="true" fill="#191813"><rect x="5" y="0" width="4" height="34"/><rect x="10" y="0" width="2" height="34"/><rect x="14" y="0" width="1" height="34"/><rect x="18" y="0" width="1" height="34"/><rect x="24" y="0" width="1" height="34"/><rect x="26" y="0" width="3" height="34"/><rect x="30" y="0" width="1" height="34"/><rect x="33" y="0" width="2" height="34"/><rect x="36" y="0" width="3" height="34"/><rect x="41" y="0" width="1" height="34"/><rect x="44" y="0" width="2" height="34"/><rect x="47" y="0" width="3" height="34"/><rect x="52" y="0" width="2" height="34"/><rect x="57" y="0" width="2" height="34"/><rect x="62" y="0" width="2" height="34"/><rect x="66" y="0" width="4" height="34"/><rect x="71" y="0" width="3" height="34"/><rect x="77" y="0" width="2" height="34"/><rect x="85" y="0" width="3" height="34"/><rect x="96" y="0" width="3" height="34"/><rect x="101" y="0" width="2" height="34"/><rect x="106" y="0" width="3" height="34"/><rect x="114" y="0" width="4" height="34"/><rect x="119" y="0" width="4" height="34"/><rect x="126" y="0" width="2" height="34"/><rect x="133" y="0" width="1" height="34"/><rect x="137" y="0" width="1" height="34"/><rect x="140" y="0" width="1" height="34"/></svg><p>00412 2609 AS</p></div>
        <div class="tk-stamp" aria-hidden="true"><span>CHECKED<b>READY TO<br>PRINT</b>ABIMRA</span></div>
      </article>
