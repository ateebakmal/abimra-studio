{%- comment -%} Abimra Studio: About page, closer. Styles: assets/abimra-about.css. Motion: assets/abimra-about.js. {%- endcomment -%}
{{ 'abimra-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'abimra-about.js' | asset_url }}" defer></script>
<div class="abt">
  <div class="abt-wrap"><section class="abt-closer abt-rv">
    <h2 class="abt-d">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="abt-btn abt-btn-i" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
  </section></div>
</div>
{% schema %}
{
  "name": "About: closer",
  "tag": "div",
  "class": "section-abt-closer",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "What will\nyou make?",
      "info": "A line break here breaks the heading."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Your name. Your artwork. Your message. On a tee or a hoodie, printed to order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Design your own"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "About: closer"
    }
  ]
}
{% endschema %}
