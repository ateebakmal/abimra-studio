{%- comment -%} Abimra Studio: About page, hero. Styles: assets/abimra-about.css. Motion: assets/abimra-about.js. {%- endcomment -%}
{{ 'abimra-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'abimra-about.js' | asset_url }}" defer></script>
<section class="abt abt-hero" id="abt-hero-{{ section.id }}">
  <div class="abt-wrap">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="abt-mono">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- assign l1 = section.settings.line_1 | escape -%}{%- assign l2 = section.settings.line_2 | escape -%}{%- assign l3 = section.settings.line_3 | escape -%}
      <h1 class="abt-d abt-reg" aria-label="{{ l1 }} {{ l2 }} {{ l3 }}">
        {%- if l1 != blank -%}<span data-t="{{ l1 }}" aria-hidden="true">{{ l1 }}</span>{%- endif -%}
        {%- if l2 != blank -%}<span data-t="{{ l2 }}" aria-hidden="true">{{ l2 }}</span>{%- endif -%}
        {%- if l3 != blank -%}<span data-t="{{ l3 }}" aria-hidden="true">{{ l3 }}</span>{%- endif -%}
      </h1>
    </div>
    <div class="abt-hero-grid abt-rv">
      <p class="abt-lede">{{ section.settings.intro | escape }}</p>
      <div class="abt-hero-ctas">
        {%- if section.settings.button_1_label != blank -%}<a class="abt-btn abt-btn-p" href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}">{{ section.settings.button_1_label | escape }}</a>{%- endif -%}
        {%- if section.settings.button_2_label != blank -%}<a class="abt-btn abt-btn-s" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">{{ section.settings.button_2_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    {%- if section.settings.show_cue -%}<span class="abt-cue" aria-hidden="true"><i></i>SCROLL</span>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "About: hero",
  "tag": "div",
  "class": "section-abt-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "About Abimra Studio"
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Headline, line 1",
      "default": "We print"
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Headline, line 2",
      "default": "what you"
    },
    {
      "type": "text",
      "id": "line_3",
      "label": "Headline, line 3",
      "default": "make."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Abimra Studio is a small print studio in the UK. You bring the idea: a name, a photo, a sketch, a logo, the in-joke only your lot will get. We turn it into a tee or hoodie made just for you."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Red button",
      "default": "Design your own"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Red button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Outline button",
      "default": "Shop Studio Originals"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Outline button link"
    },
    {
      "type": "checkbox",
      "id": "show_cue",
      "label": "Show the scroll cue",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "About: hero"
    }
  ]
}
{% endschema %}
