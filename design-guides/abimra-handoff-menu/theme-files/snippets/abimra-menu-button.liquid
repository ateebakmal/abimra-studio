{%- comment -%}
  Abimra Studio: the pill that opens the menu. Put it where the theme's mobile menu button sits in the header,
  and let the theme's existing breakpoint rules show it on mobile and tablet only.
  Usage: {% render 'abimra-menu-button' %}  or  {% render 'abimra-menu-button', label: 'Menu' %}
{%- endcomment -%}
<button type="button" class="am-btn" data-am-open aria-controls="abimra-menu" aria-expanded="false" aria-label="Open menu"><span aria-hidden="true">{{ label | default: 'Menu' | escape }}</span><i class="am-btn__bars" aria-hidden="true"></i></button>
