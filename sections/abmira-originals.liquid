{% render 'abmira-symbols' %}

{%- comment -%}
  Real products in the same scroll-at-every-width rail as the categories.

  Two sources. A collection fills the rail on its own, so new products
  appear without anyone opening the theme editor. Hand-picked blocks put
  the merchant in charge of which products show and in what order, which
  is what a curated row like Studio Originals usually wants.

  Both paths render snippets/abmira-product-card.liquid, shared with the
  collection grid, the catalogue and search, so a product looks the same
  everywhere it appears.

  Backdrops rotate through the photographic set so a row of cards does
  not read as one flat block. They sit behind the garment only - never
  on UI.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign count = section.settings.products_to_show
  assign picks = section.blocks | where: 'type', 'product'
  assign backdrops = '#E8E2D4,#DFE7DC,#EDE3C9,#E3EAF6,#DCD9CF,#FBE7E1' | split: ','

  assign manual = false
  if section.settings.source == 'manual'
    assign manual = true
  endif

  # Blank label switches the badge off inside the card snippet, so there is
  # one flag to read rather than two.
  assign badge = ''
  if section.settings.show_badge
    assign badge = section.settings.badge_label
  endif
  assign badge_tag = section.settings.badge_tag | default: 'customizable'

  # Backdrop cascade. Leaving card_bg blank hands the decision back to the
  # card snippet, which falls through to the theme setting - that is what
  # "Theme default" means. A mode here overrides the theme; a colour on an
  # individual card overrides both.
  assign bg_mode = section.settings.backdrop_mode | default: 'theme'

  # A block with no product chosen yet must not count towards "has anything
  # to show", or an empty rail hides the placeholder that explains itself.
  assign chosen = 0
  for block in picks
    if block.settings.product != blank
      assign chosen = chosen | plus: 1
    endif
  endfor

  assign has_items = false
  if manual
    if chosen > 0
      assign has_items = true
    endif
  else
    if collection.products.size > 0
      assign has_items = true
    endif
  endif

  # The heading link follows whatever the rail is showing.
  assign link_url = section.settings.link_url
  if link_url == blank
    assign link_url = collection.url
  endif
-%}

{%- if section.settings.shadow_mode == 'custom' or section.settings.pad_mode == 'custom' -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      {%- if section.settings.shadow_mode == 'custom' %}
        --ab-shadow: {% render 'abmira-shadow', strength: section.settings.shadow %};
      {%- endif %}
      {%- if section.settings.pad_mode == 'custom' %}
        --ab-card-pad: {{ section.settings.pad }}px;
      {%- endif %}
    }
  {%- endstyle -%}
{%- endif -%}

<div class="ab-section">
  <section class="ab-sec">
    <div class="ab-wrap">
      <div class="ab-sec-head ab-head-row ab-rv">
        <div class="ab-sec-head-t">
          {%- if section.settings.heading != blank -%}
            <h2 class="ab-d2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>

        {%- if section.settings.link_label != blank -%}
          <a class="ab-btn ab-btn-s ab-btn-sm" href="{{ link_url | default: '#' }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="ab-rail ab-rail-prod ab-rv ab-rv-1">
        {%- if has_items -%}
          {%- if manual -%}
            {%- for block in picks -%}
              {%- if block.settings.product != blank -%}
                {%- liquid
                  assign card_bg = blank
                  if bg_mode == 'cycle'
                    assign b = forloop.index0 | modulo: backdrops.size
                    assign card_bg = backdrops[b]
                  elsif bg_mode == 'single'
                    assign card_bg = section.settings.backdrop_color
                  endif
                  if block.settings.use_bg
                    assign card_bg = block.settings.background
                  endif
                -%}
                {% render 'abmira-product-card',
                  card_product: block.settings.product,
                  index: forloop.index0,
                  lazy: true,
                  badge_label: badge,
                  badge_tag: badge_tag,
                  background: card_bg,
                  attributes: block.shopify_attributes
                %}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for product in collection.products limit: count -%}
              {%- liquid
                assign card_bg = blank
                if bg_mode == 'cycle'
                  assign b = forloop.index0 | modulo: backdrops.size
                  assign card_bg = backdrops[b]
                elsif bg_mode == 'single'
                  assign card_bg = section.settings.backdrop_color
                endif
              -%}
              {% render 'abmira-product-card',
                card_product: product,
                index: forloop.index0,
                lazy: true,
                badge_label: badge,
                badge_tag: badge_tag,
                background: card_bg
              %}
            {%- endfor -%}
          {%- endif -%}
        {%- else -%}
          {%- comment %} Editor placeholder, so the rail is visible before anything is chosen. {% endcomment -%}
          {%- for i in (1..4) -%}
            {%- liquid
              assign idx = forloop.index0 | modulo: backdrops.size
              assign backdrop = backdrops[idx]
              assign hint = 'Choose a collection'
              if manual
                assign hint = 'Add a product block'
              endif
            -%}
            <article class="ab-prod">
              <div class="ab-prod-img" style="background: {{ backdrop }};">
                <svg viewBox="0 0 300 340" width="150" style="--g: #191813;" aria-hidden="true">
                  <use href="#ab-tee"/>
                </svg>
              </div>
              <div class="ab-prod-b">
                <div class="ab-prod-row">
                  <h3 class="ab-ttl">Product title</h3>
                  <span class="ab-cost">{{ 2999 | money }}</span>
                </div>
                <span class="ab-meta">{{ hint }}</span>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Abimra product rail",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Studio Originals"
    },
    {
      "type": "header",
      "content": "Which products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "Everything in a collection" },
        { "value": "manual", "label": "Only the products I pick below" }
      ],
      "default": "collection",
      "info": "A collection keeps itself up to date as you add products. Picking products lets you control which ones show and in what order."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 6,
      "info": "Collection mode only. Picked products all show."
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button text",
      "default": "View all",
      "info": "Leave empty to hide the button."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Button target",
      "info": "Defaults to the collection above."
    },
    {
      "type": "header",
      "content": "Backdrops and shadow"
    },
    {
      "type": "paragraph",
      "content": "Theme default follows Theme settings > ABIMRA. Anything set here overrides it for this section only, and a card with its own colour overrides both."
    },
    {
      "type": "select",
      "id": "backdrop_mode",
      "label": "Backdrop",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "cycle", "label": "Cycle the palette" },
        { "value": "single", "label": "One colour" }
      ],
      "default": "theme"
    },
    {
      "type": "color",
      "id": "backdrop_color",
      "label": "Backdrop colour",
      "default": "#E8E2D4",
      "info": "Used when the backdrop is set to one colour."
    },
    {
      "type": "select",
      "id": "shadow_mode",
      "label": "Contact shadow",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "custom", "label": "Set it here" }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "shadow",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Shadow strength",
      "default": 45
    },
    {
      "type": "select",
      "id": "pad_mode",
      "label": "Space around images",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "custom", "label": "Set it here" }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "pad",
      "min": 0,
      "max": 48,
      "step": 2,
      "label": "Space around images",
      "default": 18,
      "info": "0 lets the picture fill the tile."
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge on customisable products",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge text",
      "default": "Design your own"
    },
    {
      "type": "text",
      "id": "badge_tag",
      "label": "Tag to look for",
      "default": "customizable",
      "info": "The badge shows on products carrying this tag. Sold out always wins over it."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "use_bg",
          "label": "Give this card its own backdrop",
          "default": false
        },
        {
          "type": "color",
          "id": "background",
          "label": "Backdrop",
          "default": "#E8E2D4",
          "info": "Photographic backdrops: sand #E8E2D4, sage #DFE7DC, straw #EDE3C9, blue #E3EAF6, stone #DCD9CF, red #FBE7E1."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abimra product rail"
    }
  ]
}
{% endschema %}
