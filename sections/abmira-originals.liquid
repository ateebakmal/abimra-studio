{% render 'abmira-symbols' %}

{%- comment -%}
  Real products from a collection, in the same scroll-at-every-width
  rail as the categories.

  Backdrops rotate through the photographic set so a row of cards does
  not read as one flat block. They sit behind the garment only - never
  on UI.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign products = collection.products
  assign count = section.settings.products_to_show
  assign backdrops = '#E8E2D4,#DFE7DC,#EDE3C9,#E3EAF6,#DCD9CF,#FBE7E1' | split: ','
-%}

<div class="ab-section">
  <section class="ab-sec">
    <div class="ab-wrap">
      <div class="ab-sec-head ab-rv">
        {%- if section.settings.heading != blank -%}
          <h2 class="ab-d2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="ab-meta" href="{{ collection.url | default: '#' }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="ab-rail ab-rail-prod ab-rv ab-rv-1">
        {%- if products.size > 0 -%}
          {%- for product in products limit: count -%}
            {%- liquid
              assign backdrop = backdrops[forloop.index0] | default: backdrops[0]
              assign idx = forloop.index0 | modulo: backdrops.size
              assign backdrop = backdrops[idx]
            -%}
            <article class="ab-prod">
              <a href="{{ product.url }}" class="ab-prod-img" style="background: {{ backdrop }};">
                {%- if section.settings.show_badge and product.tags contains 'customizable' -%}
                  <span class="ab-chip ab-chip-red">{{ section.settings.badge_label | escape }}</span>
                {%- endif -%}
                {%- if product.featured_media != blank -%}
                  {{
                    product.featured_media
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '288, 432, 576, 700',
                      sizes: '(min-width: 641px) 288px, 63vw',
                      alt: product.featured_media.alt | default: product.title
                  }}
                {%- else -%}
                  <svg viewBox="0 0 300 340" width="150" style="--g: #191813;" aria-hidden="true">
                    <use href="#ab-tee"/>
                  </svg>
                {%- endif -%}
              </a>
              <div class="ab-prod-b">
                <div>
                  <h3 class="ab-ttl"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                  {%- if product.has_only_default_variant == false -%}
                    <span class="ab-meta">{{ product.options_with_values.first.values.first | escape }}</span>
                  {%- endif -%}
                </div>
                <span class="ab-cost">{{ product.price | money }}</span>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Editor placeholder so the rail is visible before a collection is picked. {%- endcomment -%}
          {%- for i in (1..4) -%}
            {%- liquid
              assign idx = forloop.index0 | modulo: backdrops.size
              assign backdrop = backdrops[idx]
            -%}
            <article class="ab-prod">
              <div class="ab-prod-img" style="background: {{ backdrop }};">
                <svg viewBox="0 0 300 340" width="150" style="--g: #191813;" aria-hidden="true">
                  <use href="#ab-tee"/>
                </svg>
              </div>
              <div class="ab-prod-b">
                <div><h3 class="ab-ttl">Product title</h3><span class="ab-meta">Colour</span></div>
                <span class="ab-cost">{{ 2999 | money }}</span>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "ABMIRA product rail",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Studio Originals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 6
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link beside heading",
      "info": "Leave empty to hide."
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge on customisable products",
      "default": true,
      "info": "Shown on products tagged \"customizable\"."
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge text",
      "default": "Design your own"
    }
  ],
  "presets": [
    {
      "name": "ABMIRA product rail"
    }
  ]
}
{% endschema %}
