{% render 'abmira-symbols' %}

{%- comment -%}
  The credit badge is the most valuable component on the site.
  "Designed by Mei L. — Heavy hoodie, bone" proves these are customer
  designs rather than stock, and teaches the business model before
  anyone reads a word. Below 641px the "Designed by" prefix hides so
  the name stays on one line.
{%- endcomment -%}

{%- liquid
  assign photos = section.blocks | where: 'type', 'photo'
-%}

<div class="ab-section">
  <section class="ab-sec">
    <div class="ab-wrap">
      <div class="ab-sec-head ab-rv">
        {%- if section.settings.heading != blank -%}
          <h2 class="ab-d2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="ab-meta" style="margin: 0 0 6px;">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>

      {%- if photos.size > 0 -%}
        <div class="ab-worn-row ab-rv ab-rv-1">
          {%- for block in photos -%}
            <figure class="ab-ph" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 641px) 30vw, 92vw',
                    alt: block.settings.image.alt | default: block.settings.name
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ab-placeholder' }}
              {%- endif -%}

              {%- if block.settings.name != blank or block.settings.garment != blank -%}
                <figcaption class="ab-ph-cap">
                  <div>
                    <b>
                      {%- if block.settings.show_prefix -%}
                        <i class="ab-ph-by">Designed by </i>
                      {%- endif -%}
                      {{- block.settings.name | escape -}}
                    </b>
                    <span>{{ block.settings.garment | escape }}</span>
                  </div>
                </figcaption>
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Abmira designed and worn",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed and worn"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Real orders from real people. Tag us when yours lands and we'll add it here."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Choose model-image-1, -2 and so on from your Files."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Yusuf A."
        },
        {
          "type": "text",
          "id": "garment",
          "label": "Garment line",
          "default": "Oversized tee, black"
        },
        {
          "type": "checkbox",
          "id": "show_prefix",
          "label": "Show \"Designed by\" prefix",
          "default": true,
          "info": "Turn off for a shot that isn't a customer design, e.g. a print detail."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abmira designed and worn",
      "blocks": [
        { "type": "photo", "settings": { "name": "Yusuf A.", "garment": "Oversized tee, black" } },
        { "type": "photo", "settings": { "name": "Mei L.", "garment": "Heavy hoodie, bone" } },
        {
          "type": "photo",
          "settings": { "name": "Print detail", "garment": "DTF on washed cotton", "show_prefix": false }
        }
      ]
    }
  ]
}
{% endschema %}
