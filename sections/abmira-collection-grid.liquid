{% render 'abmira-symbols' %}

{%- comment -%}
  Abmira — collection grid ("Shop by theme").

  Two modes:

  - Automatic (default): lists every collection in the store. A collection
    created in the admin appears here on its own, with no theme-editor step,
    which is what a merchant expects from a page called Collections.
    Backgrounds and silhouettes cycle through the system palette so a row
    never reads as one flat block.

  - Manual: hand-picked blocks, for curating order, wording and colour.

  Both paths render through snippets/abmira-collection-tile.liquid so the
  markup cannot drift between them.

  The grid is auto-fill with no fixed column count, so either mode reflows
  on its own as collections are added or removed.
{%- endcomment -%}

{%- liquid
  assign tiles = section.blocks | where: 'type', 'collection'

  # Shopify has no "pick several collections" setting, so exclusions are
  # blocks. Each one holds a collection picker; its handle joins a list the
  # automatic pass skips. Unlimited, and it uses the native picker rather
  # than asking anyone to type handles.
  assign excluded = ''
  for block in section.blocks
    if block.type == 'exclude' and block.settings.collection != blank
      assign excluded = excluded | append: ',' | append: block.settings.collection.handle
    endif
  endfor
  assign excluded = excluded | split: ','

  # Where the opt-in flag lives. Collections cannot be tagged - tags exist on
  # products, customers and orders only - so a metafield is the way to mark
  # one. Namespace and key are settings so this works with whatever the
  # merchant named their definition.
  assign mf_ns = section.settings.metafield_namespace | default: 'custom'
  assign mf_key = section.settings.metafield_key | default: 'show_in_grid'

  # Photographic backdrops. Behind garments only, never on UI.
  assign backdrops = '#E8E2D4,#DFE7DC,#EDE3C9,#E3EAF6,#DCD9CF,#FBE7E1' | split: ','
  # Silhouettes stay on ink and graphite. Red is a brand colour and blue is
  # capped at two appearances per page, so neither belongs on a repeating
  # decorative element.
  assign inks = '#191813,#5F5B52' | split: ','
-%}

<div class="ab-section">
  <section class="ab-sec">
    <div class="ab-wrap">
      <div class="ab-sec-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ab-d2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>

      <div class="ab-coll-grid">
        {%- if section.settings.source == 'manual' -%}
          {%- for block in tiles -%}
            {%- liquid
              assign collection = block.settings.collection

              assign title = block.settings.title_override
              if title == blank
                assign title = collection.title
              endif

              assign count = blank
              if collection != blank
                assign count = collection.all_products_count
              endif

              assign symbol = '#ab-tee'
              if block.settings.garment == 'hood'
                assign symbol = '#ab-hood'
              endif

              assign image = collection.image
              if image == blank and section.settings.use_product_image
                assign image = collection.products.first.featured_image
              endif
            -%}
            {% render 'abmira-collection-tile',
              url: collection.url,
              title: title,
              count: count,
              image: image,
              bg: block.settings.bg,
              symbol: symbol,
              garment_color: block.settings.garment_color,
              attributes: block.shopify_attributes
            %}
          {%- endfor -%}

        {%- else -%}
          {%- liquid
            assign shown = 0
            assign index = 0
          -%}
          {%- for collection in collections -%}
            {%- liquid
              # frontpage is Shopify's internal default collection - it exists
              # in every store and is not meant for customers.
              assign skip = false
              if collection.handle == 'frontpage'
                assign skip = true
              endif
              if section.settings.hide_empty and collection.all_products_count == 0
                assign skip = true
              endif
              if excluded contains collection.handle
                assign skip = true
              endif
              if section.settings.source == 'metafield'
                assign marked = collection.metafields[mf_ns][mf_key].value
                unless marked
                  assign skip = true
                endunless
              endif
              if shown >= section.settings.limit
                assign skip = true
              endif
            -%}
            {%- unless skip -%}
              {%- liquid
                assign b = index | modulo: backdrops.size
                assign i = index | modulo: inks.size
                assign symbol = '#ab-tee'
                assign alt = index | modulo: 3
                if alt == 2
                  assign symbol = '#ab-hood'
                endif
                assign shown = shown | plus: 1
                assign index = index | plus: 1

                # The collection's own image, then its first product's, then
                # nothing - which falls through to the silhouette variant.
                assign image = collection.image
                if image == blank and section.settings.use_product_image
                  assign image = collection.products.first.featured_image
                endif
              -%}
              {% render 'abmira-collection-tile',
                url: collection.url,
                title: collection.title,
                count: collection.all_products_count,
                image: image,
                bg: backdrops[b],
                symbol: symbol,
                garment_color: inks[i]
              %}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Abmira shop by theme",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by theme"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "The same garments, grouped by what people actually search for. A place to start if you're not sure."
    },
    {
      "type": "header",
      "content": "Which collections"
    },
    {
      "type": "paragraph",
      "content": "Three ways to choose what appears: every collection automatically, only those ticked on their own admin page, or only blocks added below. The first two pick up new collections without anyone touching this page."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "auto", "label": "All collections, automatically" },
        { "value": "metafield", "label": "Only collections marked in the admin" },
        { "value": "manual", "label": "Only the ones I pick below" }
      ],
      "default": "auto",
      "info": "Automatic and marked-in-the-admin both pick up new collections on their own. Only the last one needs a block adding here."
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom",
      "info": "For 'marked in the admin'. Shopify uses 'custom' unless you chose otherwise."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "show_in_grid",
      "info": "Create it once at Settings > Custom data > Collections, as a true/false field. Each collection then gets a checkbox on its own admin page."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Maximum tiles",
      "default": 12,
      "info": "Automatic mode only."
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Hide collections with no products",
      "default": true,
      "info": "Automatic mode only. Turn off to see collections you are still filling."
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "Fall back to the first product's image",
      "default": true,
      "info": "Used when a collection has no image of its own. With neither, the tile shows a garment silhouette."
    }
  ],
  "blocks": [
    {
      "type": "exclude",
      "name": "Hide a collection",
      "settings": [
        {
          "type": "paragraph",
          "content": "This collection will not be shown in the grid. Only applies when Source is set to all collections."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection to hide"
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override",
          "info": "Leave blank to use the collection title. Set this to lay out a tile before its collection exists."
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#E8E2D4",
          "info": "Use a photographic backdrop: sand #E8E2D4, stone #DCD9CF, blue #E3EAF6, red #FBE7E1, sage #DFE7DC, straw #EDE3C9."
        },
        {
          "type": "select",
          "id": "garment",
          "label": "Silhouette",
          "options": [
            { "value": "tee", "label": "T-shirt" },
            { "value": "hood", "label": "Hoodie" }
          ],
          "default": "tee"
        },
        {
          "type": "color",
          "id": "garment_color",
          "label": "Silhouette colour",
          "default": "#191813"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abmira shop by theme"
    }
  ]
}
{% endschema %}
