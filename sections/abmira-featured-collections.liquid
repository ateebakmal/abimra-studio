{%- comment -%}
  Abmira — featured collections.

  Repeatable blocks, no hardcoded handles and no fixed column count: the
  grid is auto-fit, so two blocks render 2-up, three render 3-up, and they
  collapse to 1-up on narrow screens with no CSS change.

  A card renders whatever the merchant has or has not set. The image falls
  back through override -> collection image -> first product image, and if
  all three are empty the card keeps its --b-sand ground rather than
  collapsing or showing a broken image.
{%- endcomment -%}

{%- liquid
  assign cards = section.blocks | where: 'type', 'collection'
-%}

<div class="ab-section">
  <section class="ab-sec">
    <div class="ab-wrap">
      <div class="ab-coll-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ab-eyebrow"><i></i>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ab-d2">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>

      {%- if cards.size > 0 -%}
        <div class="ab-coll-feature">
          {%- for block in cards -%}
            {%- liquid
              assign collection = block.settings.collection

              assign image = block.settings.image
              if image == blank
                assign image = collection.image
              endif
              if image == blank
                assign image = collection.products.first.featured_image
              endif

              assign title = block.settings.title_override
              if title == blank
                assign title = collection.title
              endif

              assign meta = block.settings.meta
              if meta == blank and collection != blank
                assign meta = collection.all_products_count | append: ' designs'
              endif

              # The first two cards are above the fold.
              assign loading = 'lazy'
              if forloop.index <= 2
                assign loading = 'eager'
              endif
            -%}

            {%- comment -%}
              One <a> wraps the whole card, with the title inside it, rather
              than a div with a nested link.
            {%- endcomment -%}
            {%- liquid
              # See abmira-hero.liquid: a piped default inside a filter
              # argument applies to the tag, not to the argument. A
              # collection image has no alt unless one was typed in.
              assign coll_alt = image.alt
              if coll_alt == blank
                assign coll_alt = title
              endif
            -%}
            <a
              class="ab-coll-card"
              href="{{ collection.url | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 900, 1200',
                    sizes: '(min-width: 1025px) 46vw, 92vw',
                    loading: loading,
                    alt: coll_alt
                }}
              {%- endif -%}

              <span class="ab-coll-scrim" aria-hidden="true"></span>

              <div class="ab-coll-cap">
                {%- if title != blank -%}
                  <h2 class="ab-d3">{{ title | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.blurb != blank -%}
                  <p>{{ block.settings.blurb | escape }}</p>
                {%- endif -%}
                {%- if meta != blank -%}
                  <span class="ab-coll-pill">{{ meta | escape }}</span>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Abmira collections",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Everything we make"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Start from a blank and make it yours, or take one of ours. Every garment on the site opens in the designer."
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta line",
          "info": "e.g. 3 garments · 12 colours. Leave blank to show the product count."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Defaults to the collection image set in admin, then the first product's image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abmira collections",
      "blocks": [{ "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
