
{%- comment -%}
  A horizontal rail that scrolls at EVERY width, not just mobile. Above
  1280 the cards fit without scrolling; below that they scroll and the
  next card peeks at the edge. That peek is the affordance - no arrows,
  no dots.

  The negative inline margin bleeds the rail to the screen edge while
  the first card stays on the grid. Don't remove it.

  Two sources, matching the product rail below it. A collection fills the
  row on its own, so a garment added in the admin shows up without anyone
  opening the theme editor. Hand-picked blocks put the merchant in charge
  of order, wording and colour.

  Both paths render snippets/abmira-category-card.liquid, so the markup
  cannot drift between them.

  "View all" is a button beside the heading rather than a card at the end
  of the row: a card that is not a garment reads as one until you reach
  it, and on a scrolling rail it is the one card nobody scrolls to.
{%- endcomment -%}

{%- liquid
  assign picks = section.blocks | where: 'type', 'category'
  assign backdrops = '#E8E2D4,#DFE7DC,#EDE3C9,#E3EAF6,#DCD9CF,#FBE7E1' | split: ','

  assign collection = section.settings.collection
  assign count = section.settings.products_to_show

  assign manual = true
  if section.settings.source == 'collection'
    assign manual = false
  endif

  # Backdrop cascade: theme setting, then this section, then the colour on
  # an individual card.
  assign bg_mode = section.settings.backdrop_mode | default: 'theme'

  assign link_url = section.settings.link_url
  if link_url == blank
    assign link_url = collection.url
  endif

  assign has_items = false
  if manual
    if picks.size > 0
      assign has_items = true
    endif
  else
    if collection.products.size > 0
      assign has_items = true
    endif
  endif
-%}

{%- if section.settings.shadow_mode == 'custom' -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --ab-shadow: {% render 'abmira-shadow', strength: section.settings.shadow %};
    }
  {%- endstyle -%}
{%- endif -%}

<div class="ab-section">
  <section class="ab-sec">
    <div class="ab-wrap">
      <div class="ab-sec-head ab-head-row ab-rv">
        <div class="ab-sec-head-t">
          {%- if section.settings.heading != blank -%}
            <h2 class="ab-d2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <p class="ab-meta">{{ section.settings.body | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.link_label != blank -%}
          <a class="ab-btn ab-btn-s ab-btn-sm" href="{{ link_url | default: '#' }}">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      {%- if has_items -%}
        <div class="ab-rail ab-rail-cat ab-rv ab-rv-1">
          {%- if manual -%}
            {%- for block in picks -%}
              {%- liquid
                assign product = block.settings.product
                assign block_collection = block.settings.collection

                # Most specific wins: an explicit link, then a product, then a
                # collection. A card with none of the three still renders, so a
                # row can be laid out before its collections exist.
                assign target = block.settings.link
                if target == blank and product != blank
                  assign target = product.url
                endif
                if target == blank and block_collection != blank
                  assign target = block_collection.url
                endif

                assign label = block.settings.heading
                if label == blank and product != blank
                  assign label = product.title
                endif
                if label == blank and block_collection != blank
                  assign label = block_collection.title
                endif

                # Override, then the product's own photo, then the collection's,
                # then its first product's. None of them means the flat card.
                assign image = block.settings.image
                if image == blank and product != blank
                  assign image = product.featured_media
                endif
                if image == blank and block_collection != blank
                  assign image = block_collection.image
                endif
                if image == blank and block_collection != blank
                  assign image = block_collection.products.first.featured_media
                endif

                assign ground = blank
                if bg_mode == 'cycle'
                  assign b = forloop.index0 | modulo: backdrops.size
                  assign ground = backdrops[b]
                elsif bg_mode == 'single'
                  assign ground = section.settings.backdrop_color
                endif
                if block.settings.use_bg
                  assign ground = block.settings.background
                endif
                if ground == blank
                  assign ground = block.settings.background
                endif
              -%}
              {% render 'abmira-category-card',
                url: target,
                title: label,
                caption: block.settings.caption,
                image: image,
                background: ground,
                invert: block.settings.invert,
                attributes: block.shopify_attributes
              %}
            {%- endfor -%}

          {%- else -%}
            {%- for product in collection.products limit: count -%}
              {%- liquid
                assign b = forloop.index0 | modulo: backdrops.size

                assign ground = backdrops[b]
                if settings.abmira_card_backdrop_mode == 'single'
                  assign ground = settings.abmira_card_backdrop | default: '#E8E2D4'
                endif
                if bg_mode == 'cycle'
                  assign ground = backdrops[b]
                elsif bg_mode == 'single'
                  assign ground = section.settings.backdrop_color
                endif

                # "From" only where the price actually varies, so a garment on
                # one price does not claim a range it has not got.
                assign amount = product.price_min | money
                if product.price_varies
                  assign caption = 'From ' | append: amount
                else
                  assign caption = amount
                endif
              -%}
              {% render 'abmira-category-card',
                url: product.url,
                title: product.title,
                caption: caption,
                image: product.featured_media,
                background: ground
              %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Abmira categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customise apparel"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Which cards"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "Everything in a collection" },
        { "value": "manual", "label": "Only the cards I add below" }
      ],
      "default": "manual",
      "info": "A collection keeps itself up to date as you add products. Adding cards lets you set the order, wording and colour of each one."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 6,
      "info": "Collection mode only. Added cards all show."
    },
    {
      "type": "header",
      "content": "Backdrops and shadow"
    },
    {
      "type": "paragraph",
      "content": "Theme default follows Theme settings > ABMIRA. Anything set here overrides it for this section only, and a card with its own backdrop switched on overrides both."
    },
    {
      "type": "select",
      "id": "backdrop_mode",
      "label": "Backdrop",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "cycle", "label": "Cycle the palette" },
        { "value": "single", "label": "One colour" }
      ],
      "default": "theme"
    },
    {
      "type": "color",
      "id": "backdrop_color",
      "label": "Backdrop colour",
      "default": "#E8E2D4",
      "info": "Used when the backdrop is set to one colour."
    },
    {
      "type": "select",
      "id": "shadow_mode",
      "label": "Contact shadow",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "custom", "label": "Set it here" }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "shadow",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Shadow strength",
      "default": 45
    },
    {
      "type": "header",
      "content": "View all button"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button text",
      "default": "View all",
      "info": "Leave empty to hide the button."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Button target",
      "info": "Defaults to the collection above."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Card",
      "limit": 8,
      "settings": [
        {
          "type": "paragraph",
          "content": "Point the card at a collection or at a single product. If you set both, the product wins. Leave both empty and set a link below to send it anywhere."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Its title, image and link are used unless you override them below."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Use this for a card that opens one garment in the designer."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Defaults to the product photo, then the collection image. With none of them the card is a flat colour."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "From £24.99",
          "info": "Plain text - it is not read from the product, so update it if your prices change. Leave empty to hide the line."
        },
        {
          "type": "checkbox",
          "id": "use_bg",
          "label": "Give this card its own backdrop",
          "default": false,
          "info": "Off means it follows the section, then the theme."
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "#E8E2D4",
          "info": "Use one of the photographic backdrops: sand #E8E2D4, sage #DFE7DC, blue #E3EAF6, straw #EDE3C9."
        },
        {
          "type": "checkbox",
          "id": "invert",
          "label": "Invert this card",
          "default": false,
          "info": "Dark card. Use it to pick one garment out of the row."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abmira categories",
      "blocks": [
        { "type": "category", "settings": { "heading": "T-shirts", "caption": "From £24.99", "background": "#E8E2D4" } },
        { "type": "category", "settings": { "heading": "Hoodies", "caption": "From £44.99", "background": "#DFE7DC" } },
        {
          "type": "category",
          "settings": { "heading": "Sweatshirts", "caption": "From £39.99", "background": "#E3EAF6" }
        }
      ]
    }
  ]
}
{% endschema %}
