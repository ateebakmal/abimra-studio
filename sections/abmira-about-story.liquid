{{ 'abmira-about.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Abimra About: how it started.

  A 5:4 photo beside the story, stacking below 861px.

  Anything still in [square brackets] is wrapped in a <mark> and shown in
  red with a dashed underline. The point is that unfinished copy cannot
  quietly go live: a placeholder that looks like ordinary text is one
  nobody notices for a year. The replace runs on the rendered rich text,
  so it works whatever the editor wrapped it in.
{%- endcomment -%}

{%- liquid
  assign story = section.settings.text | replace: '[', '<mark class="ab-fill">[' | replace: ']', ']</mark>'
  assign sign_name = section.settings.sign_name | escape | replace: '[', '<mark class="ab-fill">[' | replace: ']', ']</mark>'
-%}

<div class="ab-section ab-about">
  <section class="ab-sec"{% if section.settings.tight_top %} style="padding-top: 0;"{% endif %}>
    <div class="ab-wrap">
      <div class="ab-about-story ab-rv">
        <div class="ab-about-story-img">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                widths: '400, 600, 900, 1200, 1400',
                sizes: '(min-width: 861px) 46vw, 92vw',
                loading: 'lazy',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- else -%}
            <div class="ab-about-story-ph">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2.5"/>
                <circle cx="9" cy="10" r="1.8"/>
                <path d="m4 18 5-5 4 3.5L17 12l3 3"/>
              </svg>
              <span class="ab-meta">
                {{- section.settings.image_note | default: 'A photo of the studio, the press or the people. 5:4 landscape, about 2000 × 1600.' | escape -}}
              </span>
            </div>
          {%- endif -%}
        </div>

        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="ab-d2">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="ab-about-story-t" style="margin-top: 22px;">{{ story }}</div>
          {%- endif -%}

          {%- if section.settings.sign_name != blank or section.settings.sign_initials != blank -%}
            <div class="ab-about-sign">
              {%- if section.settings.sign_initials != blank -%}
                <b aria-hidden="true">{{ section.settings.sign_initials | escape }}</b>
              {%- endif -%}
              <span>
                <span>{{ sign_name }}</span>
                {%- if section.settings.sign_role != blank -%}
                  <em>{{ section.settings.sign_role | escape }}</em>
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "About: how it started",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Anything you leave in [square brackets] shows in red with a dashed line under it, so it can't go live unnoticed."
    },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "5:4 landscape, about 2000 × 1600." },
    { "type": "text", "id": "image_note", "label": "Note shown while there is no photo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it started" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story",
      "default": "<p>Abimra Studio started in [year] in [town or city], when [founder's name] [one line on why: for example, couldn't find anywhere to print one good tee without ordering fifty].</p><p>So we set up our own press. Today we print tees, hoodies and sweatshirts for birthdays, leavers, teams, bands, small businesses and anyone with an idea worth wearing, one order at a time.</p><p>[A line about the team today, or what's next for the studio.]</p>"
    },
    {
      "type": "header",
      "content": "Signature"
    },
    { "type": "text", "id": "sign_initials", "label": "Initials", "default": "AS" },
    { "type": "text", "id": "sign_name", "label": "Name", "default": "[Founder's name]" },
    { "type": "text", "id": "sign_role", "label": "Role", "default": "Founder, Abimra Studio" },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "tight_top",
      "label": "Remove the space above",
      "default": true,
      "info": "On when the facts strip sits directly above this."
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
