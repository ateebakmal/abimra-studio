{%- comment -%}
  ABIMRA footer.

  Three link columns beside a brand column, each driven by a Shopify
  navigation menu so the links are editable in Online Store > Navigation.
  Two columns on phones, four from 1025px.

  The colour bar under the blurb is print furniture - a strip of swatches
  standing in for a press colour bar. The guide allows two such devices
  per page; the marquee's registration mark is the other one.
{%- endcomment -%}

{%- liquid
  assign columns = section.blocks | where: 'type', 'column'
  assign legal = section.blocks | where: 'type', 'legal'

  # Only load the consent script when a block actually asks for it.
  # `where` reads a property off the block itself, and this one lives in
  # block.settings, so it has to be looked for by hand.
  assign wants_cookies = false
  for b in legal
    if b.settings.policy == 'cookies' and b.settings.link == blank
      assign wants_cookies = true
      break
    endif
  endfor
-%}

{%- if wants_cookies -%}
  <script src="{{ 'abmira-cookie-prefs.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="ab-foot">
  <div class="ab-wrap">
    <div class="ab-foot-grid">
      <div>
        <a href="{{ routes.root_url }}" class="ab-logo">
          {{- section.settings.logo_text | default: shop.name | escape -}}
        </a>

        {%- if section.settings.blurb != blank -%}
          <p class="ab-foot-blurb">{{ section.settings.blurb | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.show_colour_bar -%}
          <div class="ab-bar" style="margin-top: 22px;" aria-hidden="true">
            <span style="background: var(--red);"></span>
            <span style="background: var(--blue);"></span>
            <span style="background: var(--paper);"></span>
            <span style="background: var(--graphite);"></span>
          </div>
        {%- endif -%}

        {%- comment -%}
          Four fixed platforms, each with its own switch and address in
          the theme editor. A fixed list rather than blocks because the
          set does not change and a merchant should not have to know that
          an icon is a "block" to add one.

          On the storefront an icon needs both: switched on AND given an
          address. An icon with no link behind it says the studio is on
          Instagram and then goes nowhere, which is worse than no icon.
          In the theme editor a switched-on platform always shows, dashed
          and dim, so whoever is filling them in can see what is left.
        {%- endcomment -%}
        {%- liquid
          assign networks = 'instagram,facebook,twitter,tiktok' | split: ','
          assign net_names = 'Instagram,Facebook,X,TikTok' | split: ','

          assign social_shown = 0
          for net in networks
            assign on_key = 'show_' | append: net
            assign url_key = net | append: '_link'
            assign is_on = section.settings[on_key]
            assign url = section.settings[url_key]
            if is_on
              if url != blank or request.design_mode
                assign social_shown = social_shown | plus: 1
              endif
            endif
          endfor
        -%}

        {%- if social_shown > 0 -%}
          <ul class="ab-foot-social" role="list">
            {%- for net in networks -%}
              {%- liquid
                assign on_key = 'show_' | append: net
                assign url_key = net | append: '_link'
                assign is_on = section.settings[on_key]
                assign url = section.settings[url_key]
                assign name = net_names[forloop.index0]
                assign icon = 'icon-' | append: net | append: '.svg'
              -%}
              {%- if is_on -%}
                {%- if url != blank -%}
                  <li>
                    <a href="{{ url }}" aria-label="{{ name }}" rel="noopener" target="_blank">
                      {{ icon | inline_asset_content }}
                    </a>
                  </li>
                {%- elsif request.design_mode -%}
                  <li class="ab-foot-social-todo">
                    <span
                      role="img"
                      aria-label="{{ name }} — no link set yet"
                      title="Add a link for {{ name }} and the icon goes live."
                    >
                      {{ icon | inline_asset_content }}
                    </span>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for block in columns -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h5>{{ block.settings.heading | escape }}</h5>
          {%- endif -%}
          {%- liquid
            # A Shopify menu when one is chosen, otherwise the lines typed
            # into the block: "Label | /url", one per line. Without this a
            # column cannot say anything until someone has built a menu in
            # the admin, which is a long way to go for four links.
            assign rows = ''
            if block.settings.menu == blank and block.settings.links != blank
              assign rows = block.settings.links | newline_to_br | split: '<br />'
            endif
          -%}
          {%- if block.settings.menu != blank -%}
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- elsif rows.size > 0 -%}
            <ul>
              {%- for row in rows -%}
                {%- liquid
                  assign parts = row | split: '|'
                  assign text = parts[0] | strip
                  assign href = parts[1] | strip | default: '#'
                -%}
                {%- if text != blank -%}
                  <li><a href="{{ href }}">{{ text | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.legal_details != blank -%}
      <p class="ab-foot-reg">{{ section.settings.legal_details | escape | newline_to_br }}</p>
    {%- endif -%}

    <div class="ab-foot-bot">
      <span>
        &copy; {{ 'now' | date: '%Y' }}
        {{ section.settings.logo_text | default: shop.name | escape }}
        {{ section.settings.copyright_suffix | escape }}
      </span>
      {%- if legal.size > 0 -%}
        <nav class="ab-foot-legal" aria-label="{{ 'sections.footer.payment' | t | default: 'Legal' }}">
          {%- for block in legal -%}
            {%- liquid
              # An explicit link wins. Otherwise fall back to the Shopify
              # policy it names, which is nil until that policy has been
              # written - so an unwritten policy leaves no dead link.
              assign href = block.settings.link
              if href == blank
                case block.settings.policy
                  when 'privacy'
                    assign href = shop.privacy_policy.url
                  when 'terms'
                    assign href = shop.terms_of_service.url
                  when 'refund'
                    assign href = shop.refund_policy.url
                  when 'shipping'
                    assign href = shop.shipping_policy.url
                  when 'contact'
                    assign href = shop.contact_information.url
                endcase
              endif
            -%}
            {%- if block.settings.policy == 'cookies' and block.settings.link == blank -%}
              {%- comment -%}
                Cookie preferences is not a page. It reopens Shopify's consent
                banner, which only exists once that banner is switched on under
                Settings > Customer privacy. So the button ships hidden and
                abmira-cookie-prefs.js reveals it only after it has found a
                consent API to call - a store with no banner shows no control
                at all, rather than one that does nothing.
              {%- endcomment -%}
              {%- if block.settings.label != blank -%}
                <button type="button" class="ab-foot-cookies" data-ab-cookie-prefs hidden {{ block.shopify_attributes }}>
                  {{- block.settings.label | escape -}}
                </button>
              {%- endif -%}
            {%- elsif href != blank and block.settings.label != blank -%}
              <a href="{{ href }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Abimra footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Abimra",
      "info": "Leave empty to use the store name."
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Wear it. Make it yours.\nDesigned and printed in the United Kingdom."
    },
    {
      "type": "checkbox",
      "id": "show_colour_bar",
      "label": "Show colour bar",
      "default": true,
      "info": "Print furniture. The guide allows two such devices per page."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "paragraph",
      "content": "Switch a platform off to remove its icon. A platform that is on but has no address shows here in the editor, dashed, and is left out of the live site — an icon that goes nowhere is worse than no icon."
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram address",
      "info": "e.g. https://instagram.com/yourstudio"
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Facebook",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook address",
      "info": "e.g. https://facebook.com/yourstudio"
    },
    {
      "type": "checkbox",
      "id": "show_twitter",
      "label": "X (Twitter)",
      "default": true
    },
    {
      "type": "url",
      "id": "twitter_link",
      "label": "X (Twitter) address",
      "info": "e.g. https://x.com/yourstudio"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_link",
      "label": "TikTok address",
      "info": "e.g. https://tiktok.com/@yourstudio"
    },
    {
      "type": "textarea",
      "id": "legal_details",
      "label": "Company details",
      "info": "Company number, registered office, VAT number. Shown above the bottom rule. Leave empty to hide."
    },
    {
      "type": "header",
      "content": "Bottom line"
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "After the year",
      "default": "Studio"
    },
    {
      "type": "text",
      "id": "legal_text_unused",
      "label": "Legal line",
      "default": "Privacy · Terms · Accessibility"
    }
  ],
  "blocks": [
    {
      "type": "legal",
      "name": "Legal link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Privacy"
        },
        {
          "type": "select",
          "id": "policy",
          "label": "Shopify policy",
          "options": [
            { "value": "none", "label": "None - use the link below" },
            { "value": "privacy", "label": "Privacy policy" },
            { "value": "terms", "label": "Terms of service" },
            { "value": "refund", "label": "Refund policy" },
            { "value": "shipping", "label": "Shipping policy" },
            { "value": "contact", "label": "Contact information" },
            { "value": "cookies", "label": "Cookie preferences (reopens the consent banner)" }
          ],
          "default": "privacy",
          "info": "Points at the policy written under Settings > Policies. The link disappears until that policy has something in it, so it can never be a dead link. Cookie preferences is different: it reopens the consent banner, and only shows once that banner is switched on under Settings > Customer privacy."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the policy above. Use this for anything that is not a Shopify policy."
        }
      ]
    },
    {
      "type": "column",
      "name": "Link column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links",
          "info": "One per line, as Label | /url. Ignored when a menu is chosen below."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Create these in Online Store > Navigation."
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
