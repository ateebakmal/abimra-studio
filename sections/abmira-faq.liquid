{%- comment -%}
  Abmira — frequently asked questions.

  Native <details>/<summary>, which means it opens without JavaScript,
  is keyboard operable for free, and - the part that matters on a policy
  page - its closed content is still found by the browser's own find-in-
  page and by search engines.

  It reuses .ab-guide from the product page's size guide rather than
  defining a second accordion, so the two cannot drift apart.
{%- endcomment -%}

{%- liquid
  assign items = section.blocks | where: 'type', 'question'
-%}

<div class="ab-section">
  <section class="ab-sec">
    <div class="ab-wrap">
      <div class="ab-sec-head ab-rv">
        {%- if section.settings.heading != blank -%}
          <h2 class="ab-d2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="ab-meta">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>

      {%- if items.size > 0 -%}
        <div class="ab-faq ab-rv ab-rv-1">
          {%- for block in items -%}
            <details
              class="ab-guide ab-faq-item"
              {% if block.settings.open %}open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary>
                {{ block.settings.question | escape }}
                <span class="ab-guide-sign" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </summary>
              <div class="ab-guide-body">
                {{ block.settings.answer }}
              </div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Abmira FAQ",
  "tag": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common questions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "info": "Leave empty to hide."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "My design printed smaller than I expected"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false,
          "info": "Use on the first one if it answers most of the emails you get."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abmira FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
