{%- comment -%}
  ABMIRA header.

  Sticky at top:0 - the guide's top:44px is only to clear the mockup's own
  page-switcher bar.

  The inline links hide below 861px and the drawer takes over, matching the
  breakpoint the rest of the system uses. The drawer markup is always
  rendered but is display:none above 861, so there is never a second copy
  of the navigation in the accessibility tree.

  Menu content comes from a Shopify navigation menu, so it is editable in
  Online Store > Navigation rather than hard-coded.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign cart_count = cart.item_count
-%}

<div class="ab-section">
  <nav class="ab-nav" aria-label="Main navigation">
    <div class="ab-nav-in">
      {%- comment -%}
        [abmira] The Abimra menu pill replaces the old burger here. It
        keeps the .ab-burger class alongside its own so the theme's
        existing breakpoint rule still hides it at 861px - one place
        decides when the mobile menu exists.
      {%- endcomment -%}
      {% render 'abimra-menu-button' %}

      <a href="{{ routes.root_url }}" class="ab-logo">
        {{- section.settings.logo_text | default: shop.name | escape -}}
        {%- if section.settings.logo_sub != blank -%}
          <b>{{ section.settings.logo_sub | escape }}</b>
        {%- endif -%}
      </a>

      {%- if menu != blank -%}
        <div class="ab-nav-links">
          {%- for link in menu.links -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
              {{- link.title | escape -}}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ab-nav-r">
        <a
          href="{{ routes.cart_url }}"
          class="ab-bag"
          aria-label="{{ section.settings.cart_label | default: 'Bag' | escape }}, {{ cart_count }} items"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 12.5H6.2Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke-linecap="round"/></svg>
          <b>{{ cart_count }}</b>
        </a>
        {%- if section.settings.cta_label != blank -%}
          <a
            class="ab-btn ab-btn-p ab-btn-sm ab-nav-cta"
            href="{{ section.settings.cta_link | default: routes.root_url }}"
          >
            {{- section.settings.cta_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </nav>

  {%- comment -%} Drawer: only reachable below 861px, where it is displayed. {%- endcomment -%}
  {%- comment -%}
    [abmira] The theme's own drawer, replaced by snippets/abimra-menu.liquid.
    Left in place rather than deleted: its CSS is in assets/abmira.css
    (.ab-drawer*, body.ab-drawer-open) and its JS is initDrawer() in
    assets/abmira.js, and neither throws when this markup is absent -
    initDrawer bails on its first querySelector. Delete all three together
    when the new menu has been signed off.
  {%- endcomment -%}
  {%- if false -%}
  <div class="ab-drawer" id="AbmiraDrawer" data-abmira-drawer>
    <div class="ab-drawer-scrim" data-abmira-drawer-close></div>

    <div class="ab-drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="ab-drawer-top">
        <span class="ab-logo">{{ section.settings.logo_text | default: shop.name | escape }}</span>
        <button
          type="button"
          class="ab-drawer-close"
          aria-label="Close menu"
          data-abmira-drawer-close
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      {%- if menu != blank -%}
        <div class="ab-drawer-links">
          {%- for link in menu.links -%}
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
              {{- link.title | escape -}}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="ab-drawer-foot">
        {%- if section.settings.cta_label != blank -%}
          <a
            class="ab-btn ab-btn-p"
            href="{{ section.settings.cta_link | default: routes.root_url }}"
          >
            {{- section.settings.cta_label | escape -}}
          </a>
        {%- endif -%}
        <a
          href="{{ routes.cart_url }}"
          class="ab-bag"
          aria-label="{{ section.settings.cart_label | default: 'Bag' | escape }}, {{ cart_count }} items"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 12.5H6.2Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke-linecap="round"/></svg>
          <b>{{ cart_count }}</b>
        </a>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%}
    [abmira] Rendered once, last in the section. Nothing on the way up to
    it sets transform, filter or contain, so position: fixed still resolves
    against the viewport - checked before wiring it here.

    breakpoint is 861 because that is where this theme swaps the pill for
    the desktop links, not the 990 in the snippet's own default.
  {%- endcomment -%}
  {% render 'abimra-menu',
    menu: section.settings.abimra_menu,
    cta_label: section.settings.abimra_cta_label,
    cta_link: section.settings.abimra_cta_link,
    returns_link: section.settings.abimra_returns_link,
    contact_link: section.settings.abimra_contact_link,
    logo_mark: section.settings.abimra_logo_mark,
    logo_text: section.settings.logo_text,
    logo_sub: section.settings.logo_sub,
    breakpoint: 861
  %}
</div>

{% schema %}
{
  "name": "Abmira header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Abmira",
      "info": "Set in condensed caps with wide letter-spacing. Leave empty to use the store name."
    },
    {
      "type": "text",
      "id": "logo_sub",
      "label": "Wordmark, second word",
      "default": "Studio",
      "info": "Set in a lighter weight beside the first. Used in the header and in the mobile menu, so they cannot disagree. Leave empty for one word."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart label",
      "default": "Bag"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Design your own",
      "info": "Hidden below 641px to keep the bar from crowding; still present in the drawer."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Mobile menu"
    },
    {
      "type": "link_list",
      "id": "abimra_menu",
      "label": "Menu links",
      "default": "main-menu",
      "info": "Top-level links only. Shown as the big outline words."
    },
    {
      "type": "text",
      "id": "abimra_cta_label",
      "label": "Red button text",
      "default": "Design your own"
    },
    {
      "type": "url",
      "id": "abimra_cta_link",
      "label": "Red button link",
      "info": "The Customify designer product page."
    },
    {
      "type": "url",
      "id": "abimra_returns_link",
      "label": "Returns link",
      "info": "Leave empty to use the store's refund policy."
    },
    {
      "type": "url",
      "id": "abimra_contact_link",
      "label": "Contact us link",
      "info": "Leave empty to use /pages/contact."
    },
    {
      "type": "checkbox",
      "id": "abimra_logo_mark",
      "label": "Show the logo mark in the menu",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
