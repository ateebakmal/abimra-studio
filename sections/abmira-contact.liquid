{%- comment -%}
  Abimra — contact.

  Shopify's own {% form 'contact' %}, so submissions arrive by email with
  no app and no endpoint of ours to keep alive. Any field named
  contact[Something] turns up in that email under that name, which is why
  the names here are plain English rather than handles - they are read by
  a person, not parsed.

  contact[email] is the one Shopify treats specially: it validates it and
  sets it as the reply-to, so answering the email answers the customer.
  contact[body] becomes the body of the message rather than another
  labelled line.

  NO FILE UPLOAD. Shopify's contact form cannot take one - there is no
  multipart handling behind it, so a file input here would look like it
  worked and quietly drop the photo. The mockup's drop zone is replaced by
  a line telling people where to send one. An app is the only way to have
  real uploads.

  The right-hand column is blocks: 'detail' rows gather into the first
  card, each 'note' block becomes a card of its own below. Icons are
  inline SVG rather than the shared sprite, because a <use> pointing at a
  symbol that was never rendered fails silently.
{%- endcomment -%}

{%- liquid
  assign details = section.blocks | where: 'type', 'detail'
  assign notes = section.blocks | where: 'type', 'note'
  assign anchor = section.settings.anchor | default: 'contact'
  assign subjects = section.settings.subjects | newline_to_br | split: '<br />'
-%}

<div class="ab-section">
  <section class="ab-sec ab-contact" id="{{ anchor }}">
    <div class="ab-wrap">
      <div class="ab-contact-grid ab-rv">
        <div class="ab-contact-card ab-contact-main">
          {%- form 'contact', id: 'AbimraContact', class: 'ab-form' -%}
            {%- if form.posted_successfully? -%}
              <p class="ab-form-ok" role="status">
                {{ section.settings.success | escape }}
              </p>
            {%- elsif form.errors -%}
              <p class="ab-form-bad" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}

            <div class="ab-form-row">
              <div class="ab-field">
                <label for="AbName">{{ section.settings.label_name | escape }}</label>
                <input
                  type="text"
                  id="AbName"
                  name="contact[Name]"
                  value="{{ form.name }}"
                  placeholder="{{ section.settings.ph_name | escape }}"
                  autocomplete="name"
                  required
                >
              </div>

              <div class="ab-field">
                <label for="AbEmail">{{ section.settings.label_email | escape }}</label>
                <input
                  type="email"
                  id="AbEmail"
                  name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  placeholder="{{ section.settings.ph_email | escape }}"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  required
                  {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
                >
              </div>
            </div>

            <div class="ab-form-row">
              {%- if subjects.size > 0 -%}
                <div class="ab-field">
                  <label for="AbSubject">{{ section.settings.label_subject | escape }}</label>
                  <div class="ab-select">
                    <select id="AbSubject" name="contact[Subject]">
                      {%- for subject in subjects -%}
                        {%- assign option = subject | strip -%}
                        {%- if option != blank -%}
                          <option value="{{ option | escape }}">{{ option }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                    <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m1 1 4 4 4-4"/></svg>
                  </div>
                </div>
              {%- endif -%}

              {%- if section.settings.show_order -%}
                <div class="ab-field">
                  <label for="AbOrder">
                    {{ section.settings.label_order | escape }}
                    <i>{{ section.settings.optional_word | escape }}</i>
                  </label>
                  <input type="text" id="AbOrder" name="contact[Order number]" placeholder="{{ section.settings.ph_order | escape }}">
                </div>
              {%- endif -%}
            </div>

            <div class="ab-field">
              <label for="AbBody">{{ section.settings.label_message | escape }}</label>
              <textarea id="AbBody" name="contact[body]" rows="5" placeholder="{{ section.settings.ph_message | escape }}" required>{{ form.body }}</textarea>
            </div>

            {%- if section.settings.attach_note != blank -%}
              <p class="ab-form-attach">{{ section.settings.attach_note }}</p>
            {%- endif -%}

            <div class="ab-form-foot">
              <button type="submit" class="ab-btn ab-btn-p">
                {{ section.settings.submit | escape }}
              </button>
              {%- if section.settings.small_print != blank -%}
                <small>{{ section.settings.small_print }}</small>
              {%- endif -%}
            </div>
          {%- endform -%}
        </div>

        <aside class="ab-contact-side">
          {%- if details.size > 0 -%}
            <div class="ab-contact-card">
              {%- if section.settings.side_heading != blank -%}
                <h2 class="ab-contact-h">{{ section.settings.side_heading | escape }}</h2>
              {%- endif -%}

              <ul class="ab-detail-list" role="list">
                {%- for block in details -%}
                  <li {{ block.shopify_attributes }}>
                    <span class="ab-detail-ico" aria-hidden="true">
                      {%- case block.settings.icon -%}
                        {%- when 'phone' -%}
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 11.3v2a1.3 1.3 0 0 1-1.5 1.3 13 13 0 0 1-5.6-2 12.8 12.8 0 0 1-3.9-3.9 13 13 0 0 1-2-5.7A1.3 1.3 0 0 1 2.7 1.5h2a1.3 1.3 0 0 1 1.3 1.1c.1.7.2 1.3.5 1.9a1.3 1.3 0 0 1-.3 1.4l-.8.8a10.7 10.7 0 0 0 3.9 3.9l.8-.8a1.3 1.3 0 0 1 1.4-.3c.6.2 1.2.4 1.9.5a1.3 1.3 0 0 1 1.1 1.3Z"/></svg>
                        {%- when 'clock' -%}
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.4"/><path d="M8 4.4V8l2.4 1.4"/></svg>
                        {%- when 'pin' -%}
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M13.3 6.9c0 4-5.3 7.7-5.3 7.7S2.7 10.9 2.7 6.9a5.3 5.3 0 1 1 10.6 0Z"/><circle cx="8" cy="6.9" r="1.9"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="1.6" y="3.2" width="12.8" height="9.6" rx="1.4"/><path d="m1.9 4.1 6.1 4.3 6.1-4.3"/></svg>
                      {%- endcase -%}
                    </span>
                    <div>
                      {%- if block.settings.title != blank -%}
                        {%- if block.settings.link != blank -%}
                          <a class="ab-detail-t" href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                        {%- else -%}
                          <b class="ab-detail-t">{{ block.settings.title | escape }}</b>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <span class="ab-detail-s">{{ block.settings.text | escape }}</span>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- for block in notes -%}
            <div class="ab-contact-card" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="ab-contact-h">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="ab-contact-note">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </aside>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Abimra contact",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "contact",
      "info": "Link to this form from anywhere with #contact."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "paragraph",
      "content": "Submissions go to the email set under Settings > Notifications in the admin. The customer's address becomes the reply-to, so you answer them by replying."
    },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "ph_name", "label": "Name placeholder", "default": "Sarah Whitfield" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "ph_email", "label": "Email placeholder", "default": "sarah@example.com" },
    { "type": "text", "id": "label_subject", "label": "Subject label", "default": "What's this about?" },
    {
      "type": "textarea",
      "id": "subjects",
      "label": "Subject options",
      "default": "An order I've placed\nA problem with a print\nHelp with the designer\nGroup or team order\nSomething else",
      "info": "One per line. Leave empty to hide the dropdown."
    },
    { "type": "checkbox", "id": "show_order", "label": "Ask for an order number", "default": true },
    { "type": "text", "id": "label_order", "label": "Order number label", "default": "Order number" },
    { "type": "text", "id": "ph_order", "label": "Order number placeholder", "default": "#1026" },
    { "type": "text", "id": "optional_word", "label": "Optional marker", "default": "— optional" },
    { "type": "text", "id": "label_message", "label": "Message label", "default": "Message" },
    {
      "type": "text",
      "id": "ph_message",
      "label": "Message placeholder",
      "default": "Tell us what happened. If it's a print problem, a photo helps more than a description."
    },
    {
      "type": "richtext",
      "id": "attach_note",
      "label": "About photos",
      "default": "<p>Got a photo? Email it to hello@abimra.studio with your order number and we'll match it to this message. Shopify's form can't carry attachments.</p>",
      "info": "Shopify's contact form cannot accept file uploads, so this line tells people where to send one. Leave empty to hide it."
    },
    { "type": "text", "id": "submit", "label": "Button text", "default": "Send message" },
    {
      "type": "richtext",
      "id": "small_print",
      "label": "Small print",
      "default": "<p>We'll only use your details to answer this message.</p>"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Thank you message",
      "default": "Thanks — that's with us. You'll hear back within one working day."
    },
    {
      "type": "header",
      "content": "Side column"
    },
    { "type": "text", "id": "side_heading", "label": "First card heading", "default": "Reach us directly" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mail", "label": "Email" },
            { "value": "phone", "label": "Phone" },
            { "value": "clock", "label": "Clock" },
            { "value": "pin", "label": "Location" }
          ],
          "default": "mail"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "hello@abimra.studio" },
        { "type": "text", "id": "text", "label": "Note underneath", "default": "Best for order questions and artwork help." },
        { "type": "url", "id": "link", "label": "Link", "info": "For an email address use mailto:, for a number use tel:." }
      ]
    },
    {
      "type": "note",
      "name": "Side card",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The studio" },
        { "type": "richtext", "id": "body", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abimra contact",
      "blocks": [{ "type": "detail" }, { "type": "note" }]
    }
  ]
}
{% endschema %}
