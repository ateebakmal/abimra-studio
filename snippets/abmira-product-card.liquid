{% comment %}
  Abmira product card.

  Shared by the collection grid, the catalogue, search and the homepage
  rail, so a product looks the same everywhere it appears.

  The image sits on a photographic backdrop that cycles by position, so a
  row never reads as one flat block. Body is a title/price row with a meta
  line beneath: garment type, then the colour count.

  The colour count is text rather than swatch dots. Dots answer "which
  colours"; at card size that is unreadable, and the question a shopper is
  actually asking here is "is there more than one".

  Accepts:
  - card_product:  {Object}  product
  - index:         {Number}  position, used to pick the backdrop
  - lazy:          {Boolean} lazy-load the image
  - color_option:  {String}  name of the colour option, default 'Color'
  - new_tag:       {String}  tag that marks a product as new, default 'new'
  - badge_label:   {String}  chip shown on products carrying badge_tag; blank for none
  - badge_tag:     {String}  tag the badge looks for, default 'customizable'
  - background:    {String}  ground colour; overrides the palette and the theme setting
  - attributes:    {String}  block.shopify_attributes, when it came from a block

  Usage:
  {% render 'abmira-product-card', card_product: product, index: forloop.index0 %}
{% endcomment %}

{%- liquid
  assign wanted = color_option | default: 'Color' | downcase | strip
  assign new_tag = new_tag | default: 'new'
  assign badge_tag = badge_tag | default: 'customizable'
  assign index = index | default: 0

  assign backdrops = '#E8E2D4,#DFE7DC,#EDE3C9,#E3EAF6,#DCD9CF,#FBE7E1' | split: ','
  assign b = index | modulo: backdrops.size
  assign backdrop = backdrops[b]

  # Theme setting, so the whole store changes together rather than section
  # by section. Cycling is the default because a row of identical grounds
  # reads as one flat block.
  if settings.abmira_card_backdrop_mode == 'single'
    assign backdrop = settings.abmira_card_backdrop | default: '#E8E2D4'
  endif

  # A caller that has already decided - a section on its own setting, or a
  # block with its own colour - passes it in and wins over both.
  if background != blank
    assign backdrop = background
  endif

  assign colors = null
  for opt in card_product.options_with_values
    assign opt_name = opt.name | downcase | strip
    if opt_name == wanted
      assign colors = opt
      break
    endif
  endfor

  # "Oversized tee · 4 colours". Either half is dropped when absent, so a
  # product with no type set still reads cleanly.
  assign meta = ''
  if card_product.type != blank
    assign meta = card_product.type
  endif
  if colors != blank and colors.values.size > 1
    assign count_label = colors.values.size | append: ' colours'
    if meta != blank
      assign meta = meta | append: ' · ' | append: count_label
    else
      assign meta = count_label
    endif
  endif

  assign loading = 'lazy'
  unless lazy
    assign loading = 'eager'
  endunless
-%}

<article class="ab-prod" {{ attributes }}>
  <a class="ab-prod-img" href="{{ card_product.url }}" style="background: {{ backdrop }};" tabindex="-1" aria-hidden="true">
    {%- if card_product.featured_media != blank -%}
      {{
        card_product.featured_media
        | image_url: width: 700
        | image_tag:
          widths: '210, 320, 480, 700',
          sizes: '(min-width: 1025px) 25vw, (min-width: 641px) 33vw, 50vw',
          loading: loading,
          alt: card_product.featured_media.alt | default: card_product.title
      }}
    {%- else -%}
      <svg viewBox="0 0 300 340" width="150" style="--g: #191813;" aria-hidden="true">
        <use href="#ab-tee"/>
      </svg>
    {%- endif -%}

    {%- if card_product.available == false -%}
      <span class="ab-chip ab-chip-ink">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif badge_label != blank and card_product.tags contains badge_tag -%}
      <span class="ab-chip ab-chip-red">{{ badge_label | escape }}</span>
    {%- elsif card_product.tags contains new_tag -%}
      <span class="ab-chip ab-chip-red">New</span>
    {%- endif -%}
  </a>

  <div class="ab-prod-b">
    <div class="ab-prod-row">
      <h3 class="ab-ttl"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      <span class="ab-cost">
        {%- if card_product.compare_at_price > card_product.price -%}
          <s>{{ card_product.compare_at_price | money }}</s>
          <span class="ab-cost-sale">{{ card_product.price | money }}</span>
        {%- else -%}
          {{ card_product.price | money }}
        {%- endif -%}
      </span>
    </div>

    {%- if meta != blank -%}
      <span class="ab-meta">{{ meta | escape }}</span>
    {%- endif -%}
  </div>
</article>
