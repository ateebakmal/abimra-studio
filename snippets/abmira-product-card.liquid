{% comment %}
  Abmira product card.

  Used by the collection grid, the catalogue and search, so every product
  listing on the site is the same object. The homepage rail uses the same
  .ab-prod markup inline.

  Colour swatches appear only when the product actually has a colour option
  with more than one value - a single-colour product gets nothing rather
  than a lone dot, and a product with no colour option is unaffected.

  Accepts:
  - card_product:  {Object}  product
  - lazy:          {Boolean} lazy-load the image
  - color_option:  {String}  name of the colour option, default 'Color'
  - max_swatches:  {Number}  how many dots before "+n", default 5

  Usage:
  {% render 'abmira-product-card', card_product: product, lazy: true %}
{% endcomment %}

{%- liquid
  assign wanted = color_option | default: 'Color' | downcase | strip
  assign max_swatches = max_swatches | default: 5

  assign colors = null
  for opt in card_product.options_with_values
    assign opt_name = opt.name | downcase | strip
    if opt_name == wanted
      assign colors = opt
      break
    endif
  endfor

  assign loading = 'lazy'
  unless lazy
    assign loading = 'eager'
  endunless
-%}

<article class="ab-prod">
  <a class="ab-prod-img" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
    {%- if card_product.featured_media != blank -%}
      {{
        card_product.featured_media
        | image_url: width: 700
        | image_tag:
          widths: '210, 320, 480, 700',
          sizes: '(min-width: 1025px) 25vw, (min-width: 641px) 33vw, 50vw',
          loading: loading,
          alt: card_product.featured_media.alt | default: card_product.title
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'ab-placeholder' }}
    {%- endif -%}

    {%- unless card_product.available -%}
      <span class="ab-chip ab-chip-ink">{{ 'products.product.sold_out' | t }}</span>
    {%- endunless -%}
  </a>

  <div class="ab-prod-b">
    <div>
      <h3 class="ab-ttl"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>

      {%- if colors != blank and colors.values.size > 1 -%}
        <div class="ab-prod-swatches" aria-label="{{ colors.values.size }} colours">
          {%- for value in colors.values limit: max_swatches -%}
            {%- liquid
              assign fill = value.swatch.color
              if value.swatch.image
                assign fill = null
              endif
            -%}
            <span
              class="ab-sw{% unless value.available %} ab-sw-out{% endunless %}"
              title="{{ value | escape }}"
              {% if value.swatch.image %}
                style="background-image: url({{ value.swatch.image | image_url: width: 40 }});"
              {% elsif fill %}
                style="background: {{ fill }};"
              {% endif %}
            ></span>
          {%- endfor -%}
          {%- if colors.values.size > max_swatches -%}
            {%- assign extra = colors.values.size | minus: max_swatches -%}
            <span class="ab-sw-more">+{{ extra }}</span>
          {%- endif -%}
        </div>
      {%- elsif card_product.has_only_default_variant == false -%}
        <span class="ab-meta">{{ card_product.options_with_values.first.values.first | escape }}</span>
      {%- endif -%}
    </div>

    <span class="ab-cost">
      {%- if card_product.compare_at_price > card_product.price -%}
        <s>{{ card_product.compare_at_price | money }}</s>
        <span class="ab-cost-sale">{{ card_product.price | money }}</span>
      {%- else -%}
        {{ card_product.price | money }}
      {%- endif -%}
    </span>
  </div>
</article>
