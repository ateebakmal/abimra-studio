{%- comment -%}
  Abimra Studio: "First pull" intro preloader, for a visitor's first page view in a session.
  Render it as the very first thing inside <body> in layout/theme.liquid:
    {% render 'abimra-preloader' %}
  Needs assets/abimra-preloader.css, abimra-preloader.js and three.min.js (loaded only when the intro plays).
  Never shows inside the theme editor. Settings live in Theme settings > Intro preloader.
{%- endcomment -%}
{%- liquid
  assign apl_on = true
  if settings.abimra_preloader_enabled == false or request.design_mode
    assign apl_on = false
  endif
  if settings.abimra_preloader_scope != 'all' and template.name != 'index'
    assign apl_on = false
  endif
  assign apl_once = true
  if settings.abimra_preloader_once == false
    assign apl_once = false
  endif
  assign apl_s1 = settings.abimra_preloader_stage_1 | default: 'Fetching your design'
  assign apl_s2 = settings.abimra_preloader_stage_2 | default: 'Printing'
  assign apl_s3 = settings.abimra_preloader_stage_3 | default: 'Shipping your order'
-%}
{%- if apl_on -%}
  {%- if apl_once -%}
    {%- comment -%}
      [abmira] localStorage, not sessionStorage: the intro plays on a
      first visit and never again. This must match assets/abimra-preloader.js,
      which reads and writes the same key - if the two ever disagree the
      overlay flashes before the script hides it.
    {%- endcomment -%}
    <script>try{if(localStorage.getItem('abimra:intro-seen')==='1')document.documentElement.classList.add('apl-seen')}catch(e){}</script>
  {%- endif -%}
  {{ 'abimra-preloader.css' | asset_url | stylesheet_tag }}
<div id="abimra-preloader" class="apl" data-min="{{ settings.abimra_preloader_min | default: 2400 }}" data-once="{{ apl_once }}" data-three="{{ 'three.min.js' | asset_url }}" data-stages="{{ apl_s1 | escape }}|{{ apl_s2 | escape }}|{{ apl_s3 | escape }}" data-done="{{ settings.abimra_preloader_done | default: 'Ready to wear' | escape }}" aria-label="Loading Abimra Studio">
  <canvas class="apl__bg" aria-hidden="true"></canvas>
  <canvas class="apl__gl" aria-hidden="true"></canvas>
  <div class="apl__frame" aria-hidden="true"><svg class="apl__mark" viewBox="-20 -20 40 40"><g class="m1"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m2"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m3"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g></svg><svg class="apl__mark" viewBox="-20 -20 40 40"><g class="m1"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m2"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m3"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g></svg><svg class="apl__mark" viewBox="-20 -20 40 40"><g class="m1"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m2"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m3"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g></svg><svg class="apl__mark" viewBox="-20 -20 40 40"><g class="m1"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m2"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g><g class="m3"><circle r="9"/><path d="M-17 0H17M0-17V17"/></g></svg></div>
  <div class="apl__ui">
    <div class="apl__top">
      <div class="apl__brand"><svg  viewBox="-20 -20 40 40" aria-hidden="true"><circle r="10" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M-18 0H18M0-18V18" stroke="currentColor" stroke-width="2.6"/><circle r="3.8" fill="#D42E12"/></svg><span>Abimra Studio</span></div>
      <button type="button" class="apl__skip" data-apl-skip>Skip intro</button>
    </div>
    <div></div>
    <div class="apl__bottom">
      <div>
        <div class="apl__num" aria-hidden="true"><span data-apl-num>0</span><sup>%</sup></div>
        <div class="apl__status"><i class="apl__swatch" data-apl-swatch></i><span data-apl-status>{{ apl_s1 | escape }}</span></div>
        <div class="apl__seg" aria-hidden="true"><span><i></i></span><span><i></i></span><span><i></i></span></div>
      </div>
      <div class="apl__side">
        <p class="apl__line">{{ settings.abimra_preloader_line | default: "Custom tees and hoodies, printed to order in our own UK studio." | escape }}</p>
        <p class="apl__hint">Drag to spin. Tap the tee to swap black and white.</p>
      </div>
    </div>
  </div>
  <div class="apl__blade" aria-hidden="true"></div>
  <p class="apl__sr" data-apl-sr role="status">Loading</p>
</div>
  <script src="{{ 'abimra-preloader.js' | asset_url }}" defer></script>
{%- else -%}
  <script>document.documentElement.classList.add('intro-done')</script>
{%- endif -%}
